{
  "expo": {
    "name": "Haline",
    "slug": "haline",
    "version": "1.0.0",
    "scheme": "haline",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#01050b"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01050b"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bcaris.haline",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd08fc0f-4f2d-4b27-9733-6bf2ad98fa1e"
      }
    },
    "owner": "cero.1"
  }
}
